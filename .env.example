# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-service.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_OAI_DEPLOYMENT=your-deployment-name

# Azure Computer Vision Configuration
AZURE_COMPUTER_VISION_ENDPOINT=https://your-computer-vision.cognitiveservices.azure.com/
AZURE_COMPUTER_VISION_KEY=your-computer-vision-key

# Azure Storage Configuration (Using Default Credentials)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
BLOB_CONTAINER_NAME=your-container-name
BLOB_CONTAINER_NAME_IMG=your-image-container-name

# Azure Search Configuration
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net

# Backend Service Endpoints (if using external services)
NEXT_PUBLIC_UPLOAD_IMAGE_ENDPOINT=/api/upload
NEXT_PUBLIC_PROCESS_REQUEST_ENDPOINT=your-process-endpoint
NEXT_PUBLIC_CREATE_THREAD_ENDPOINT=your-create-thread-endpoint
NEXT_PUBLIC_AZURE_ASSISTANT_INTENT=your-assistant-id

# Legacy - deprecated in favor of Azure Default Credentials
# BLOB_CONNECTION_STRING=your-blob-connection-string
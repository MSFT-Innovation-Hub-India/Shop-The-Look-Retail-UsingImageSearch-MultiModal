# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-api-key
AZURE_OAI_DEPLOYMENT=your-deployment-name

# Azure Computer Vision Configuration
AZURE_COMPUTER_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
AZURE_COMPUTER_VISION_KEY=your-vision-api-key

# Azure Blob Storage Configuration (Managed Identity)
# Note: Connection strings are no longer used - managed identity authentication is required
BLOB_STORAGE_ACCOUNT_NAME=yourstorageaccount
BLOB_CONTAINER_NAME=your-container-name
BLOB_CONTAINER_NAME_IMG=your-images-container-name

# Azure Resource Information (Required for Managed Identity)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group-name

# Azure AI Search Configuration
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net

# IMPORTANT: Managed Identity Setup Required
# ==========================================
# This application uses Azure Managed Identity for blob storage authentication.
# Ensure the following RBAC roles are assigned to the managed identity:
#
# On Storage Account:
#   - Storage Blob Data Contributor (for reading/writing blobs)
#   - Storage Blob Delegator (for generating user delegation SAS tokens)
#
# On Azure AI Search Service's Managed Identity:
#   - Storage Blob Data Reader (for indexing blobs)
#
# For local development, ensure you are logged in with Azure CLI:
#   az login
#
# Your Azure account must have the same roles assigned for local testing.
